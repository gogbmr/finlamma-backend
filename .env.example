# ---- App ----
APP_URL=http://localhost:3000
NODE_ENV=development
# VERCEL_ENV is set automatically by Vercel (production|preview|development) -
# never set it yourself locally or in .env.local.
# VERCEL_GIT_COMMIT_SHA is also set automatically by Vercel - never set it
# yourself. Surfaced (shortened) as GET /api/v1/health's `version` field.

# ---- Database (Supabase Postgres) ----
# DATABASE_URL: transaction pooler (port 6543) - used by the app at runtime
# DATABASE_URL_DIRECT: session pooler (port 5432) - used only by drizzle-kit for migrations
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---- Clerk ----
# Two separate Clerk applications - see docs/ARCHITECTURE.md decision D2.
# STAFF app: the only one that ever holds a session cookie on this domain
# (admin sign-in, clerkMiddleware()/auth()).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# CONSUMER app: the mobile app's users. Verified directly from their Bearer
# token in requireUser() - never touches clerkMiddleware()/auth().
CONSUMER_CLERK_PUBLISHABLE_KEY=
CONSUMER_CLERK_SECRET_KEY=
# CONSUMER app's webhook (syncs `users`, not `staff_members`).
CLERK_WEBHOOK_SIGNING_SECRET=
# STAFF app's webhook (completes a staff invite into `staff_members` on
# user.created; deactivates a staff_members row on user.deleted).
STAFF_CLERK_WEBHOOK_SIGNING_SECRET=

# ---- Storage (Supabase Storage via S3 API) ----
S3_ENDPOINT=https://xxx.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=finlamma

# ---- Redis (Upstash) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Jobs (Inngest) ----
# Required in Vercel (Production AND Preview) - src/lib/inngest.ts puts the
# client in Cloud mode (signature verification ON) on every real Vercel
# deployment automatically. Not required for local dev, which auto-detects
# Dev mode instead - see INNGEST_DEV below.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local dev already runs in Dev mode automatically with no key and no env var
# needed (src/lib/inngest.ts detects "not on Vercel" on its own) - this is
# kept only as an explicit, documented manual override, not required for
# `pnpm inngest:dev` to work. NEVER set this in a deployed environment
# (Vercel Production or Preview) - it's ignored there either way, but never
# add it to avoid any confusion about that.
INNGEST_DEV=1

# ---- Market & news data ----
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
INDIA_NEWS_API_KEY=

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-5

# ---- Email, push, subscriptions ----
RESEND_API_KEY=
# Must be a Resend-verified sending domain (see docs/ROADMAP.md Phase 2a).
EMAIL_FROM=Finlamma <consent@mail.finlamma.in>
EXPO_ACCESS_TOKEN=
REVENUECAT_WEBHOOK_AUTH=

# ---- Compliance ----
# A secret you generate yourself (not from any dashboard) - used to scrub a
# deleted account's parent-contact PII while keeping it verifiable. Generate
# with: openssl rand -hex 32
CONSENT_PII_HMAC_KEY=

# ---- Relay ----
RELAY_SHARED_SECRET=

# ---- Observability ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
