{
  "openapi": "3.1.0",
  "info": {
    "title": "Finlamma API",
    "version": "0.1.0",
    "description": "REST API for the Finlamma mobile app (/api/v1) and the internal admin/relay endpoints."
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "Resource not found"
              },
              "details": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ok"
                ],
                "example": "ok"
              },
              "database": {
                "type": "string",
                "enum": [
                  "ok"
                ],
                "example": "ok"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "example": "2026-01-01T00:00:00.000Z"
              }
            },
            "required": [
              "status",
              "database",
              "timestamp"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "ClerkWebhookResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "received": {
                "type": "boolean",
                "enum": [
                  true
                ]
              }
            },
            "required": [
              "received"
            ]
          }
        },
        "required": [
          "data"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health check",
        "description": "Confirms the API is running and can reach the database. Used by uptime monitors.",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database is unreachable",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "Database is unreachable"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/clerk": {
      "post": {
        "summary": "Clerk user webhook",
        "description": "Called by Clerk (not the app or the mobile client) on user.created, user.updated and user.deleted to keep our users table in sync. Authenticated by an HMAC signature in the svix-id / svix-timestamp / svix-signature headers, verified against CLERK_WEBHOOK_SIGNING_SECRET - configured as a webhook endpoint in the Clerk dashboard, not by a user or staff session.",
        "tags": [
          "Webhooks"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Unique id of this webhook delivery"
            },
            "required": true,
            "description": "Unique id of this webhook delivery",
            "name": "svix-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Unix timestamp the webhook was sent"
            },
            "required": true,
            "description": "Unix timestamp the webhook was sent",
            "name": "svix-timestamp",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "HMAC signature(s) of the request body"
            },
            "required": true,
            "description": "HMAC signature(s) of the request body",
            "name": "svix-signature",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "example": "user.created"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "type",
                  "data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event processed (or a type we don't act on)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClerkWebhookResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing/invalid svix signature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Webhook signing secret not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
