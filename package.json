{
  "name": "finlamma-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "inngest:dev": "npx inngest-cli@latest dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --reporter=default --reporter=json --outputFile.json=tests/.last-run.json",
    "posttest": "node scripts/check-test-count.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-roles.ts",
    "db:verify-pool": "tsx scripts/verify-db-pool.ts",
    "check:twelvedata": "tsx scripts/check-twelvedata-nse-access.ts",
    "backfill:world-codes": "tsx scripts/backfill-world-codes.ts",
    "seed:super-admin": "tsx scripts/seed-super-admin.ts",
    "seed:legal": "tsx scripts/seed-legal-documents.ts",
    "seed:mentors": "tsx scripts/seed-mentors.ts",
    "seed:worlds": "tsx scripts/seed-worlds.ts",
    "seed:settings": "tsx scripts/seed-settings.ts",
    "seed:reward-rules": "tsx scripts/seed-reward-rules.ts",
    "seed:instruments": "tsx scripts/seed-instruments.ts",
    "seed:market-holidays": "tsx scripts/seed-market-holidays.ts",
    "seed:funds": "tsx scripts/seed-funds.ts",
    "contract": "tsx scripts/generate-openapi.ts && node scripts/openapi-to-markdown.mjs openapi/openapi.json docs/API_ENDPOINTS.md"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@clerk/backend": "^3.18.1",
    "@clerk/nextjs": "^7.9.4",
    "@hookform/resolvers": "^5.9.1",
    "@next/env": "^16.3.5",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.9.0",
    "@scalar/nextjs-api-reference": "^0.12.0",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.21.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.1",
    "sonner": "^2.0.8",
    "svix": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2"
}
